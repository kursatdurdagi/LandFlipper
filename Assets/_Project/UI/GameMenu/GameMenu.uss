/* Land Flipper — Duraklatma: küçük tombul kart, ahşap etiket */

.pm-sheet {
    width: 380px;
    padding: 48px 28px 18px 28px;
    rotate: 0.6deg;
}

.pm-session {
    padding: 12px 16px;
    margin-bottom: 20px;
    background-color: var(--cream-2);
    border-radius: 14px;
}

.pm-mode {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--ink);
}

.pm-info {
    font-size: 14px;
    color: var(--ink-soft);
    white-space: normal;
    margin-top: 4px;
}

.pm-resume {
    height: 58px;
    font-size: 20px;
    margin-bottom: 14px;
}

.pm-confirm {
    -unity-text-align: middle-center;
}
