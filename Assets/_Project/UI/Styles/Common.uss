/* Land Flipper - ortak UI Toolkit stilleri (cozy, sıcak palet) */
:root {
    --lf-bg: #2F3A2C;
    --lf-card: #F4EBD9;
    --lf-card-2: #EBDFC6;
    --lf-ink: #3B2F25;
    --lf-muted: #7A6A58;
    --lf-line: #D9CBB0;
    --lf-accent: #5E8C4A;
    --lf-accent-hover: #6FA157;
    --lf-accent-ink: #FFFDF6;
    --lf-neutral: #E8DCC3;
    --lf-neutral-hover: #DFCFB0;
    --lf-danger: #B5533C;
    --lf-danger-hover: #C4644C;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.hidden {
    display: none;
}

/* ---------- Kart / başlıklar ---------- */
.menu-card {
    width: 460px;
    padding: 40px 40px 32px 40px;
    background-color: var(--lf-card);
    border-radius: 18px;
    border-width: 2px;
    border-color: var(--lf-line);
}

.title {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--lf-ink);
    -unity-text-align: middle-center;
}

.title.small-title {
    font-size: 38px;
    margin-bottom: 16px;
}

.subtitle {
    font-size: 18px;
    color: var(--lf-muted);
    -unity-text-align: middle-center;
    margin-bottom: 28px;
}

.section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--lf-muted);
    margin: 14px 0 4px 2px;
}

.body-text {
    font-size: 18px;
    color: var(--lf-ink);
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 12px 0;
}

.panel {
    flex-direction: column;
}

.divider {
    height: 2px;
    background-color: var(--lf-line);
    margin: 14px 0 2px 0;
}

/* ---------- Butonlar ---------- */
.lf-button {
    height: 52px;
    margin: 6px 0;
    font-size: 20px;
    -unity-font-style: bold;
    border-radius: 12px;
    border-width: 0;
    background-color: var(--lf-neutral);
    color: var(--lf-ink);
    transition-duration: 0.12s;
}

.lf-button:hover {
    background-color: var(--lf-neutral-hover);
    scale: 1.02 1.02;
}

.lf-button:active {
    scale: 0.98 0.98;
}

.lf-button:disabled {
    opacity: 0.5;
}

.lf-button.primary {
    background-color: var(--lf-accent);
    color: var(--lf-accent-ink);
}

.lf-button.primary:hover {
    background-color: var(--lf-accent-hover);
}

.lf-button.danger {
    background-color: var(--lf-danger);
    color: var(--lf-accent-ink);
}

.lf-button.danger:hover {
    background-color: var(--lf-danger-hover);
}

.lf-button.subtle {
    background-color: rgba(0, 0, 0, 0);
    color: var(--lf-muted);
}

.lf-button.subtle:hover {
    background-color: var(--lf-card-2);
}

/* ---------- Metin alanları ---------- */
.lf-field {
    margin: 4px 0;
}

.lf-field > Label {
    min-width: 70px;
    font-size: 16px;
    color: var(--lf-ink);
    -unity-text-align: middle-left;
}

.lf-field #unity-text-input {
    height: 38px;
    font-size: 18px;
    border-radius: 8px;
    border-color: var(--lf-line);
    background-color: #FFFDF6;
    color: var(--lf-ink);
    padding-left: 10px;
}

/* ---------- Durum ---------- */
.status {
    margin-top: 14px;
    font-size: 15px;
    color: var(--lf-muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

.status.error {
    color: var(--lf-danger);
}

.version {
    position: absolute;
    right: 16px;
    bottom: 12px;
    font-size: 13px;
    color: rgba(244, 235, 217, 0.5);
}

/* ---------- Ana menü ---------- */
/* Arka planda 3D diorama var; kart sola hizalı ve yarı saydam bir gölge üzerinde. */
.main-menu {
    background-color: rgba(0, 0, 0, 0);
    align-items: flex-start;
    padding-left: 110px;
}

.menu-shade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 720px;
    background-color: rgba(24, 30, 20, 0.35);
}

.main-menu .menu-card {
    background-color: rgba(244, 235, 217, 0.95);
}

/* ---------- Oyun menüsü ---------- */
.pause-overlay {
    background-color: rgba(20, 26, 18, 0.6);
}

.pause-card {
    width: 420px;
}

.info-box {
    background-color: var(--lf-card-2);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 14px;
}

.info-mode {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--lf-ink);
}

.info-text {
    font-size: 15px;
    color: var(--lf-muted);
    white-space: normal;
    margin-top: 4px;
}

/* ---------- HUD: basılı tutma halkası ---------- */
.hud-hold-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 58px;
    height: 58px;
    margin-left: -29px;
    margin-top: -29px;
}

/* ---------- HUD: seviye / XP ---------- */
.hud-level {
    position: absolute;
    top: 22px;
    left: 24px;
    flex-direction: row;
    align-items: center;
    padding: 8px 14px 8px 8px;
    border-radius: 30px;
    background-color: rgba(30, 36, 26, 0.72);
}

.hud-level-badge {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    align-items: center;
    justify-content: center;
    background-color: rgb(94, 140, 74);
    border-width: 3px;
    border-color: rgb(141, 186, 109);
    margin-right: 10px;
}

.hud-level-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 253, 246);
}

.hud-level-info {
    width: 170px;
}

.hud-xp-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 253, 246);
    margin-bottom: 4px;
}

.hud-xp-track {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.18);
    overflow: hidden;
}

.hud-xp-fill {
    height: 100%;
    width: 0%;
    border-radius: 4px;
    background-color: rgb(240, 190, 60);
    transition-property: width;
    transition-duration: 0.35s;
}

.hud-points {
    margin-left: 12px;
    padding: 4px 10px;
    border-radius: 10px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(59, 47, 37);
    background-color: rgb(255, 215, 110);
}

.hud-xp-popup {
    position: absolute;
    left: 52%;
    top: 46%;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 215, 110);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.hud-xp-popup.fade {
    opacity: 0;
    translate: 0 -18px;
}

.hud-levelup {
    position: absolute;
    top: 20%;
    left: 0;
    right: 0;
    align-items: center;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
}

.hud-levelup.fade {
    opacity: 0;
    scale: 0.9 0.9;
}

.hud-levelup-title {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(255, 215, 110);
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.75);
    letter-spacing: 3px;
}

.hud-levelup-sub {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 253, 246);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
}

/* ---------- HUD ---------- */
.hud-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 56%;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 253, 246);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
}

.hud-money {
    position: absolute;
    top: 24px;
    right: 24px;
    flex-direction: row;
    align-items: center;
    padding: 8px 16px 8px 10px;
    border-radius: 22px;
    background-color: rgba(244, 235, 217, 0.92);
    border-width: 2px;
    border-color: var(--lf-line);
    transition-duration: 0.2s;
}

.hud-money.pulse {
    scale: 1.12 1.12;
    background-color: rgb(255, 240, 190);
}

.hud-coin {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    margin-right: 8px;
    background-color: rgb(240, 190, 60);
    border-width: 2px;
    border-color: rgb(196, 140, 30);
}

.hud-money-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--lf-ink);
}

.hud-carry {
    position: absolute;
    right: 24px;
    bottom: 24px;
    min-width: 200px;
    padding: 10px 14px;
    border-radius: 12px;
    background-color: rgba(30, 36, 26, 0.72);
}

.hud-carry-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 200, 110);
    margin-bottom: 4px;
}

.hud-carry-list {
    font-size: 16px;
    color: rgb(255, 253, 246);
    white-space: normal;
}

.hud-toast {
    position: absolute;
    top: 90px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 253, 246);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.85);
}

.hud-hint {
    position: absolute;
    left: 24px;
    bottom: 20px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
}

.crosshair {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.9);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.45);
}
