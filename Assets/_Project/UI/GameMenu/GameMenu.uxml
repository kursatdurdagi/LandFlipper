<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Styles/Common.uss" />
    <Style src="GameMenu.uss" />
    <ui:VisualElement name="pause-overlay" class="screen scrim pause-overlay hidden">
        <ui:VisualElement class="sheet pm-sheet">
            <ui:VisualElement class="sticker wood"><ui:Label text="Mola" /></ui:VisualElement>

            <ui:VisualElement class="pm-session">
                <ui:Label name="mode-label" class="pm-mode" />
                <ui:Label name="info-label" class="pm-info" />
            </ui:VisualElement>

            <ui:VisualElement name="menu-panel" class="panel">
                <ui:Button name="resume-button" text="Devam et" class="lf-button primary pm-resume" />
                <ui:Button name="settings-button" text="Ayarlar" class="lf-button" />
                <ui:Button name="leave-button" text="Ana menü" class="lf-button" />
                <ui:Button name="quit-button" text="Masaüstüne çık" class="lf-button subtle" />
            </ui:VisualElement>

            <ui:VisualElement name="confirm-panel" class="panel hidden">
                <ui:Label name="confirm-label" class="body-text pm-confirm" />
                <ui:Button name="confirm-yes-button" text="Oturumu kapat" class="lf-button danger" />
                <ui:Button name="confirm-no-button" text="Vazgeç" class="lf-button subtle" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
