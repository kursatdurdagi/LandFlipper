/* Land Flipper — Ayarlar: mavi etiket, tombul sekmeler, yuvarlak satırlar */

.settings-panel {
    width: 940px;
    max-width: 94%;
    height: 640px;
    max-height: 90%;
    padding: 54px 30px 18px 30px;
}

/* ---------------------------------------------------------------- sekmeler */

.settings-tabs {
    flex-direction: row;
    margin: 0 0 16px 0;
}

.settings-tab {
    height: 42px;
    margin: 0 8px 0 0;
    padding: 0 20px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--ink-soft);
    background-color: var(--cream-2);
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ink);
    border-radius: 14px;
    transition-property: translate, background-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-back;
}

.settings-tab:hover {
    translate: 0 -2px;
    color: var(--ink);
}

.settings-tab.active {
    background-color: var(--sky);
    color: var(--cream);
    translate: 0 -2px;
}

/* ---------------------------------------------------------------- içerik */

.settings-content {
    flex-grow: 1;
}

.settings-section {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--muted);
    margin: 14px 0 6px 6px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
    padding: 6px 14px 6px 18px;
    margin: 0 0 6px 0;
    background-color: #FFFDF7;
    border-width: 2px;
    border-color: var(--cream-3);
    border-radius: 16px;
}

.settings-row:hover {
    border-color: var(--ink);
}

.settings-row-label {
    width: 250px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--ink);
}

.settings-row-sub {
    font-size: 13px;
    color: var(--ink-soft);
    white-space: normal;
}

.settings-row-control {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.settings-value {
    width: 62px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--ink);
    -unity-text-align: middle-right;
}

/* ---- kaydırıcı: kalın konturlu iz, güneş rengi topuz */
.lf-slider {
    flex-grow: 1;
    max-width: 340px;
    margin: 0 10px 0 0;
}

.lf-slider #unity-tracker {
    height: 10px;
    margin-top: -5px;
    border-width: 2px;
    border-color: var(--ink);
    border-radius: 5px;
    background-color: var(--cream-2);
}

.lf-slider #unity-dragger {
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-radius: 11px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ink);
    background-color: var(--sun);
}

.lf-slider #unity-dragger-border {
    display: none;
}

/* ---- açık / kapalı */
.lf-switch {
    width: 92px;
    height: 36px;
    margin: 0;
    font-size: 14px;
    -unity-font-style: bold;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ink);
    border-radius: 18px;
    background-color: var(--cream-2);
    color: var(--muted);
    transition-property: background-color, translate;
    transition-duration: 0.12s;
}

.lf-switch:active {
    translate: 0 2px;
}

.lf-switch.on {
    background-color: var(--leaf);
    color: var(--cream);
}

/* ---- seçici ‹ değer › */
.lf-stepper {
    flex-direction: row;
    align-items: center;
}

.lf-stepper-arrow {
    width: 36px;
    height: 36px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    -unity-font-style: bold;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ink);
    border-radius: 18px;
    background-color: var(--cream);
    color: var(--ink);
    transition-property: translate;
    transition-duration: 0.1s;
}

.lf-stepper-arrow:hover {
    background-color: var(--sun-soft);
}

.lf-stepper-arrow:active {
    translate: 0 2px;
}

.lf-stepper-value {
    width: 190px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--ink);
    -unity-text-align: middle-center;
}

/* ---- tuş atama: klavye tuşu */
.key-button {
    min-width: 80px;
    height: 38px;
    margin: 0;
    padding: 0 14px;
    font-size: 15px;
    -unity-font-style: bold;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: var(--ink);
    border-radius: 10px;
    background-color: var(--cream);
    color: var(--ink);
    transition-property: translate, border-bottom-width, background-color;
    transition-duration: 0.08s;
}

.key-button:hover {
    background-color: var(--sun-soft);
}

.key-button:active {
    translate: 0 3px;
    border-bottom-width: 2px;
}

.key-button.listening {
    background-color: var(--sun);
    rotate: -2deg;
}

.key-button.conflict {
    background-color: #FCE1D8;
    border-color: var(--tomato-lip);
    color: var(--tomato-lip);
}

.key-reset {
    width: 36px;
    height: 36px;
    margin: 0 0 0 8px;
    padding: 0;
    font-size: 17px;
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 18px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted);
}

.key-reset:hover {
    background-color: var(--cream-2);
    color: var(--ink);
}

.key-conflict-label {
    padding: 2px 8px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--cream);
    background-color: var(--tomato);
    border-radius: 8px;
    margin-right: 10px;
}

/* ---------------------------------------------------------------- alt */

.settings-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}

.settings-reset {
    width: auto;
    margin: 0;
}

.settings-hint {
    flex-grow: 1;
    font-size: 13px;
    color: var(--ink-soft);
    -unity-text-align: middle-center;
}

.settings-footer-button {
    min-width: 140px;
    margin: 0;
}
