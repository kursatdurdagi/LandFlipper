/* =====================================================================
   Land Flipper — UI tasarım sistemi (v2: "çizilmiş tombul" stil)
   Elle çizilmiş gibi: koyu kahve kontur, yumuşak köşeler, alt kenarda
   kalın "dudak" ile basılabilir 3D his. Gradient yok; derinlik = kontur + dudak.

   Kontur: 2px (küçük) · 3px (kart/panel)      Dudak: 4-5px (buton) · 8px (panel)
   Yarıçap: 10 (küçük) · 14 (buton) · 22 (panel) · tam (rozet/hap)
   Tipografi: 12 · 14 · 16 · 20 · 28 · 72 (logo)
   ===================================================================== */

:root {
    /* yüzeyler */
    --cream: #FFF6E4;
    --cream-2: #F7E9CD;
    --cream-3: #EED9B2;

    /* kontur ve metin */
    --ink: #3B2A1F;
    --ink-soft: #6A5242;
    --muted: #9B856F;

    /* renkler (topraksı ama neşeli) */
    --leaf: #79B04A;
    --leaf-lip: #4E8530;
    --leaf-soft: #E2F0CF;
    --sun: #F5C24A;
    --sun-lip: #C88F26;
    --sun-soft: #FCEBC0;
    --tomato: #E46A4B;
    --tomato-lip: #AE442E;
    --sky: #5DB2D6;
    --sky-lip: #3884A6;
    --wood: #B77B48;
    --wood-lip: #7F512E;

    --scrim: rgba(44, 30, 20, 0.55);
}

/* ---------------------------------------------------------------- iskelet */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.hidden {
    display: none;
}

.scrim {
    background-color: var(--scrim);
}

/* Tombul kart: tüm modal ekranların temel yüzeyi */
.sheet {
    background-color: var(--cream);
    border-width: 3px;
    border-bottom-width: 8px;
    border-color: var(--ink);
    border-radius: 22px;
}

.rule {
    height: 2px;
    border-radius: 1px;
    background-color: var(--cream-3);
}

/* Başlık etiketi: kartın üst kenarına yapışmış, hafif eğik renkli şerit */
.sticker {
    position: absolute;
    top: -28px;
    left: 32px;
    padding: 6px 22px 8px 22px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: var(--ink);
    border-radius: 14px;
    rotate: -2deg;
    background-color: var(--leaf);
}

.sticker > Label {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--cream);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 2px 0 rgba(59, 42, 31, 0.9);
}

.sticker.wood { background-color: var(--wood); }
.sticker.sky { background-color: var(--sky); }
.sticker.sun { background-color: var(--sun); }
.sticker.tomato { background-color: var(--tomato); }

/* ---------------------------------------------------------------- tipografi */

.t-caption {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--muted);
}

.t-body {
    font-size: 16px;
    color: var(--ink);
    white-space: normal;
}

.t-help {
    font-size: 14px;
    color: var(--ink-soft);
    white-space: normal;
}

.t-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--ink);
}

.t-subtitle {
    font-size: 14px;
    color: var(--ink-soft);
    margin-top: 4px;
}

.section-title {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--muted);
    margin: 18px 0 8px 4px;
}

.body-text {
    font-size: 16px;
    color: var(--ink);
    white-space: normal;
    margin: 4px 0 16px 0;
}

.panel {
    flex-direction: column;
}

.divider {
    height: 2px;
    background-color: var(--cream-3);
    margin: 16px 0 0 0;
}

/* ---------------------------------------------------------------- butonlar
   Basılabilir: alt dudak + hover'da hafif kalkma, basınca çökme */

.lf-button {
    height: 50px;
    margin: 0 0 10px 0;
    padding: 0 18px;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: var(--ink);
    border-radius: 14px;
    background-color: var(--cream);
    color: var(--ink);
    transition-property: translate, background-color, border-bottom-width, rotate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-back;
}

.lf-button:hover {
    translate: 0 -2px;
    background-color: #FFFBF2;
}

.lf-button:active {
    translate: 0 2px;
    border-bottom-width: 2px;
}

.lf-button:disabled {
    opacity: 0.5;
}

.lf-button.primary {
    background-color: var(--leaf);
    color: var(--cream);
}

.lf-button.primary:hover {
    background-color: #86BD55;
}

.lf-button.danger {
    background-color: var(--tomato);
    color: var(--cream);
}

.lf-button.danger:hover {
    background-color: #EC7859;
}

.lf-button.subtle {
    height: 40px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    border-bottom-width: 2px;
    color: var(--ink-soft);
    font-size: 15px;
}

.lf-button.subtle:hover {
    color: var(--ink);
    background-color: var(--cream-2);
    translate: 0 0;
}

.lf-button.row {
    -unity-text-align: middle-left;
}

/* ---------------------------------------------------------------- metin alanları */

.lf-field {
    flex-direction: column;
    margin: 0 0 12px 0;
}

.lf-field > Label {
    min-width: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--ink-soft);
    margin: 0 0 6px 4px;
    padding: 0;
    -unity-text-align: middle-left;
}

.lf-field #unity-text-input {
    height: 44px;
    margin: 0;
    padding: 0 14px;
    font-size: 16px;
    border-width: 2px;
    border-radius: 12px;
    border-color: var(--ink);
    background-color: #FFFDF7;
    color: var(--ink);
}

.lf-field:focus #unity-text-input {
    border-color: var(--leaf-lip);
    background-color: #FFFFFF;
}

/* ---------------------------------------------------------------- durum */

.status {
    margin-top: 12px;
    padding: 8px 14px;
    font-size: 14px;
    color: var(--ink);
    white-space: normal;
    background-color: var(--cream);
    border-width: 2px;
    border-color: var(--ink);
    border-radius: 12px;
}

.status.error {
    background-color: #FCE1D8;
    border-color: var(--tomato-lip);
    color: var(--tomato-lip);
}

/* ---------------------------------------------------------------- kaydırma çubuğu */

.unity-scroll-view .unity-scroller__low-button,
.unity-scroll-view .unity-scroller__high-button {
    display: none;
}

.unity-scroll-view .unity-scroller--vertical {
    width: 12px;
    margin-left: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroll-view .unity-scroller--vertical > .unity-slider {
    margin: 0;
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__tracker {
    left: 3px;
    width: 6px;
    border-width: 0;
    border-radius: 3px;
    background-color: var(--cream-2);
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    left: 1px;
    width: 10px;
    margin: 0;
    border-width: 2px;
    border-color: var(--ink);
    border-radius: 5px;
    background-color: var(--sun);
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}
