<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Styles/Common.uss" />
    <Style src="Settings.uss" />
    <ui:VisualElement name="settings-overlay" class="screen scrim settings-overlay hidden">
        <ui:VisualElement class="sheet settings-panel">
            <ui:VisualElement class="sticker sky"><ui:Label text="Ayarlar" /></ui:VisualElement>

            <ui:VisualElement name="settings-tabs" class="settings-tabs">
                <ui:Button name="tab-display" text="Görüntü" class="settings-tab" />
                <ui:Button name="tab-controls" text="Kontroller" class="settings-tab" />
                <ui:Button name="tab-audio" text="Ses" class="settings-tab" />
                <ui:Button name="tab-keys" text="Tuşlar" class="settings-tab" />
            </ui:VisualElement>

            <ui:ScrollView name="settings-content" class="settings-content" />

            <ui:VisualElement class="settings-footer">
                <ui:Button name="settings-reset" text="Varsayılana döndür" class="lf-button subtle settings-reset" />
                <ui:Label name="settings-hint" text="" class="settings-hint" />
                <ui:Button name="settings-close" text="Tamam" class="lf-button primary settings-footer-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
