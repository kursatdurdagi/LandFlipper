/* Land Flipper - Yetenek ağacı (UI Toolkit) */

.skill-overlay {
    background-color: rgba(18, 24, 16, 0.72);
}

.skill-panel {
    width: 1320px;
    max-width: 94%;
    max-height: 92%;
    padding: 30px 34px 22px 34px;
    border-radius: 22px;
    background-color: rgb(244, 235, 217);
    border-width: 3px;
    border-color: rgb(217, 203, 176);
}

/* ---------- başlık ---------- */
.skill-header {
    flex-direction: row;
    align-items: center;
    padding-bottom: 20px;
    margin-bottom: 22px;
    border-bottom-width: 2px;
    border-color: rgb(217, 203, 176);
}

.skill-title-group {
    flex-grow: 1;
}

.skill-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(59, 47, 37);
    letter-spacing: 2px;
}

.skill-subtitle {
    font-size: 16px;
    color: rgb(122, 106, 88);
    margin-top: 2px;
}

.skill-level-group {
    flex-direction: row;
    align-items: center;
    margin-right: 26px;
}

.skill-level-badge {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    align-items: center;
    justify-content: center;
    background-color: rgb(94, 140, 74);
    border-width: 4px;
    border-color: rgb(141, 186, 109);
    margin-right: 14px;
}

.skill-level-caption {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(255, 253, 246, 0.8);
    margin-bottom: -4px;
}

.skill-level-value {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 253, 246);
}

.skill-xp-group {
    width: 240px;
}

.skill-xp-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(59, 47, 37);
    margin-bottom: 6px;
}

.xp-track {
    height: 14px;
    border-radius: 7px;
    background-color: rgb(225, 212, 186);
    overflow: hidden;
}

.xp-fill {
    height: 100%;
    width: 0%;
    border-radius: 7px;
    background-color: rgb(240, 190, 60);
    transition-property: width;
    transition-duration: 0.3s;
}

.skill-points {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px;
    border-radius: 16px;
    background-color: rgb(59, 47, 37);
}

.skill-points.has-points {
    background-color: rgb(196, 120, 40);
}

.skill-points-value {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 230, 150);
    margin-right: 10px;
}

.skill-points-caption {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(255, 253, 246, 0.85);
}

/* ---------- dallar ---------- */
.skill-branches {
    flex-direction: row;
    flex-grow: 1;
}

.skill-branch {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px;
    padding: 14px;
    border-radius: 16px;
    background-color: rgb(235, 223, 198);
}

.skill-branch-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.skill-branch-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin-right: 8px;
}

.skill-branch-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(59, 47, 37);
    letter-spacing: 1px;
}

.skill-connector {
    width: 4px;
    height: 16px;
    align-self: center;
    background-color: rgb(205, 189, 160);
}

.skill-connector.active {
    background-color: rgb(94, 140, 74);
}

/* ---------- kart ---------- */
.skill-card {
    padding: 14px;
    border-radius: 14px;
    background-color: rgb(255, 251, 242);
    border-width: 2px;
    border-color: rgb(217, 203, 176);
    transition-duration: 0.12s;
}

.skill-card:hover {
    border-color: rgb(196, 160, 110);
    translate: 0 -2px;
}

.skill-card.locked {
    opacity: 0.55;
}

.skill-card.maxed {
    border-color: rgb(141, 186, 109);
    background-color: rgb(240, 248, 230);
}

.skill-card.affordable {
    border-color: rgb(240, 190, 60);
}

.skill-card-top {
    flex-direction: row;
    align-items: center;
}

.skill-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.skill-icon-text {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 253, 246);
}

.skill-name-group {
    flex-grow: 1;
}

.skill-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(59, 47, 37);
}

.skill-pips {
    flex-direction: row;
    margin-top: 5px;
}

.skill-pip {
    width: 16px;
    height: 7px;
    border-radius: 4px;
    margin-right: 4px;
    background-color: rgb(225, 212, 186);
}

.skill-pip.filled {
    background-color: rgb(94, 140, 74);
}

.skill-desc {
    font-size: 14px;
    color: rgb(122, 106, 88);
    white-space: normal;
    margin-top: 10px;
}

.skill-effect {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(94, 140, 74);
    white-space: normal;
    margin-top: 6px;
}

.skill-button {
    height: 38px;
    margin: 12px 0 0 0;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 10px;
    border-width: 0;
    background-color: rgb(94, 140, 74);
    color: rgb(255, 253, 246);
    transition-duration: 0.1s;
}

.skill-button:hover {
    background-color: rgb(111, 161, 87);
}

.skill-button:active {
    scale: 0.97 0.97;
}

.skill-button:disabled {
    background-color: rgb(205, 189, 160);
    color: rgb(122, 106, 88);
    opacity: 1;
}

/* dal renkleri */
.branch-carry { background-color: rgb(214, 132, 62); }
.branch-move { background-color: rgb(76, 140, 196); }
.branch-gather { background-color: rgb(94, 140, 74); }
.branch-yield { background-color: rgb(212, 166, 40); }

/* ---------- alt bilgi ---------- */
.skill-footer {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 18px;
}

.skill-footer-text {
    font-size: 14px;
    color: rgb(122, 106, 88);
}

.skill-footer-key {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(59, 47, 37);
}
