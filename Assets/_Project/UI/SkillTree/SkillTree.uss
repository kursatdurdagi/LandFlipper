/* Land Flipper — Yetenekler: yeşil etiketli tombul kart, dal başına renkli sütun */

.skill-panel {
    width: 1180px;
    max-width: 94%;
    max-height: 90%;
    padding: 50px 30px 20px 30px;
}

/* ---------------------------------------------------------------- başlık şeridi */

.skill-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    margin: 0 8px 22px 8px;
    background-color: var(--cream-2);
    border-radius: 18px;
}

.skill-level-badge {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    align-items: center;
    justify-content: center;
    background-color: var(--sun);
    border-width: 3px;
    border-bottom-width: 5px;
    border-color: var(--ink);
    margin-right: 16px;
}

.skill-level-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--ink);
}

.skill-xp-group {
    flex-grow: 1;
    margin-right: 20px;
}

.skill-xp-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--ink-soft);
    margin: 0 0 6px 2px;
}

.xp-track {
    height: 16px;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--ink);
    background-color: var(--cream);
    overflow: hidden;
}

.xp-fill {
    height: 100%;
    width: 0%;
    border-radius: 6px;
    background-color: var(--leaf);
    transition-property: width;
    transition-duration: 0.3s;
}

.skill-points {
    flex-direction: row;
    align-items: center;
    padding: 4px 16px 6px 16px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ink);
    border-radius: 16px;
    background-color: var(--cream);
}

.skill-points.has-points {
    background-color: var(--tomato);
    rotate: -3deg;
}

.skill-points-value {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-right: 6px;
}

.skill-points-caption {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--ink-soft);
}

.skill-points.has-points .skill-points-value,
.skill-points.has-points .skill-points-caption {
    color: var(--cream);
}

/* ---------------------------------------------------------------- dallar */

.skill-branches {
    flex-direction: row;
    flex-grow: 1;
}

.skill-branch {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px;
}

.skill-branch-header {
    flex-direction: row;
    align-items: center;
    margin: 0 0 12px 4px;
}

.skill-branch-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: var(--ink);
    margin-right: 8px;
}

.skill-branch-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--ink);
}

.skill-connector {
    width: 4px;
    height: 16px;
    margin-left: 34px;
    border-radius: 2px;
    background-color: var(--cream-3);
}

.skill-connector.active {
    background-color: var(--leaf);
}

/* ---------------------------------------------------------------- kart */

.skill-card {
    padding: 14px;
    background-color: #FFFDF7;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: var(--ink);
    border-radius: 18px;
    transition-property: translate, rotate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.skill-card:hover {
    translate: 0 -3px;
    rotate: -0.6deg;
}

.skill-card.locked {
    opacity: 0.5;
}

.skill-card.affordable {
    background-color: var(--sun-soft);
}

.skill-card.maxed {
    background-color: var(--leaf-soft);
}

.skill-card-top {
    flex-direction: row;
    align-items: center;
}

.skill-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ink);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    rotate: -4deg;
}

.skill-icon-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--cream);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

.skill-name-group {
    flex-grow: 1;
}

.skill-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--ink);
}

.skill-pips {
    flex-direction: row;
    margin-top: 6px;
}

.skill-pip {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--ink);
    margin-right: 4px;
    background-color: var(--cream);
}

.skill-pip.filled {
    background-color: var(--leaf);
}

.skill-desc {
    font-size: 14px;
    color: var(--ink-soft);
    white-space: normal;
    margin-top: 10px;
}

.skill-effect {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--leaf-lip);
    white-space: normal;
    margin-top: 6px;
}

.skill-button {
    height: 40px;
    margin: 12px 0 0 0;
    font-size: 15px;
    -unity-font-style: bold;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: var(--ink);
    border-radius: 12px;
    background-color: var(--leaf);
    color: var(--cream);
    transition-property: translate, border-bottom-width;
    transition-duration: 0.1s;
}

.skill-button:hover {
    translate: 0 -1px;
}

.skill-button:active {
    translate: 0 2px;
    border-bottom-width: 2px;
}

.skill-button:disabled {
    background-color: var(--cream-2);
    color: var(--muted);
    border-color: var(--cream-3);
    opacity: 1;
}

/* dal renkleri */
.branch-carry { background-color: var(--wood); }
.branch-move { background-color: var(--sky); }
.branch-gather { background-color: var(--leaf); }
.branch-yield { background-color: var(--sun); }

/* ---------------------------------------------------------------- alt */

.skill-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 18px 8px 0 8px;
}

.skill-footer-text {
    font-size: 14px;
    color: var(--ink-soft);
}

.skill-footer-key {
    padding: 2px 10px 4px 10px;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink);
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ink);
    border-radius: 8px;
    background-color: var(--cream);
}
